@{
    var pageTitle = ViewBag.Title == null ? "Pokédex" : ViewBag.Title + " | Pokédex";
    var description = ViewBag.Description ?? "Pokédex en español con los datos de PokeAPI: tipos, estadísticas, habilidades, debilidades y evoluciones de cada Pokémon.";
    var action = (ViewContext.RouteData.Values["action"] ?? "").ToString();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@pageTitle</title>
    <meta name="description" content="@description" />
    <meta name="theme-color" content="#c8102e" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@description" />
    @if (ViewBag.Image != null)
    {
        <meta property="og:image" content="@ViewBag.Image" />
    }
    <link rel="icon" href="@Url.Content("~/Content/favicon.svg")" type="image/svg+xml" />
    <link rel="alternate icon" href="@Url.Content("~/favicon.ico")" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://raw.githubusercontent.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700&display=swap" />
    @Styles.Render("~/Content/css")
    <script>
        // Aplica el tema guardado antes de pintar para evitar el parpadeo.
        (function () {
            try {
                var t = localStorage.getItem("pokedex-theme");
                if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
            } catch (e) { }
        })();
    </script>
</head>
<body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class="chassis">
        <div class="chassis__inner">
            <a class="brand" href="@Url.Action("Index", "Home")" aria-label="Pokédex, ir al inicio">
                <span class="brand__lens" aria-hidden="true"></span>
                <span class="brand__leds" aria-hidden="true"><i></i><i></i><i></i></span>
                <span class="brand__name">Pokédex</span>
            </a>
            <nav class="topnav" aria-label="Principal">
                <a href="@Url.Action("Index", "Home")" @(action == "Index" || action == "Pokemon" ? "aria-current=page" : "")>Especies</a>
                <a href="@Url.Action("About", "Home")" @(action == "About" ? "aria-current=page" : "")>Acerca de</a>
                <button type="button" class="theme-toggle" data-theme-toggle aria-label="Cambiar entre modo claro y oscuro">
                    <svg class="icon icon--sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" /><path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1" /></svg>
                    <svg class="icon icon--moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z" /></svg>
                </button>
            </nav>
        </div>
    </header>

    <main id="contenido" class="screen" tabindex="-1">
        @RenderBody()
    </main>

    <footer class="footer">
        <p>
            Datos e imágenes de <a href="https://pokeapi.co" rel="noopener">PokeAPI</a>.
            Pokémon y sus nombres son marcas de Nintendo, Creatures y GAME FREAK. Proyecto sin ánimo de lucro.
        </p>
    </footer>

    @Scripts.Render("~/bundles/app")
    @RenderSection("scripts", required: false)
</body>
</html>
