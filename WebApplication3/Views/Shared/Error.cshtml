@model System.Web.Mvc.HandleErrorInfo
@{
    ViewBag.Title = "Error";
}

<section class="notice">
    <p class="notice__code" aria-hidden="true">500</p>
    <h1>Algo ha fallado al cargar esta página</h1>
    <p>Vuelve a intentarlo. Si sigue pasando, vuelve al listado.</p>
    <p><a class="button" href="@Url.Action("Index", "Home")">Ir al listado</a></p>
</section>
